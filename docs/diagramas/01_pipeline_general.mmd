flowchart TB
    START(["<b>main.py</b> (con terminal) · <b>main.pyw</b> (sin terminal)<br/>cli.py · main() · lee .env"]) --> RES{"¿Qué opción?"}
    RES -->|"--resume"| SHOW["Imprime el resumen<br/>de la última ejecución<br/><b>registro.py</b>"]
    RES -->|"archivo --update / --formateo"| UPD["Carga a mano un archivo<br/>en la base local<br/><b>basedatos.py</b>"]
    RES -->|"--respaldo-nube"| BAK["Copia la base local<br/>a la nube con COPY<br/><b>nube.py</b>"]
    RES -->|"sin opción · --formateo"| IN[/"Archivos de data/raw<br/>sin opción: solo los nuevos (no están en cargas)<br/>--formateo: todos<br/>del más antiguo al más reciente"/]
    IN --> READ["Lectura · leer_tabla()<br/>CSV o Excel · todo como texto"]

    READ --> P1
    subgraph S1["PASO 1 · Conversión de fechas · fechas.py"]
        P1["Quita apóstrofo inicial (')<br/><b>convertir_fechas()</b>"] --> O1["columna <b>fecha_cast</b><br/>yyyy-mm-dd"]
    end

    O1 --> P2
    subgraph S2["PASO 2 · Análisis de costos · costos.py"]
        P2["CPM = (Valorización Local ÷ <b>Impresiones</b>) × 1000<br/><b>calcular_cpm_delta()</b>"] --> O2["columna <b>cpm_delta</b>"]
    end

    O2 --> OUT1[/"output/*_procesado.csv<br/>original + fecha_cast + cpm_delta"/]
    O2 --> F1

    subgraph S3["PASO 3 · Consumo de datos · descargas.py + navegador.py"]
        F1["Agrupa por marca y URL<br/>Σ Impresiones"] --> F2["Top 3 anuncios con<br/>más impresiones por marca"]
        F2 --> NAV["Detecta navegador predeterminado<br/>→ Brave o Edge"]
        NAV --> DL["Abre y descarga<br/>uno por uno, en orden"]
    end

    DL -->|"al terminar cada archivo"| LOAD["Carga a la base local<br/>sin opción: agrega los nuevos<br/>--formateo: reemplaza todo<br/>(solo si todos salieron bien)"]
    LOAD --> SQLITE
    LOAD -.->|"siguiente archivo nuevo"| READ
    DL --> OUT2[/"output/anuncios/&lt;marca&gt;/NN_archivo<br/>output/&lt;archivo&gt;_top_anuncios.csv"/]
    DL -->|"ruta_local, estado, sha256<br/>(no el archivo)"| SQLITE
    UPD --> SQLITE[("<b>SQLite local</b><br/>anuncios · cargas · descargas<br/>vistas v_anuncios_cpm · v_descargas_ultimas")]
    SQLITE -->|"al terminar python main.py<br/>(automático, si hay .env)"| BAK
    BAK -->|"NEON_DATABASE_URL<br/>una transacción"| NEON[("<b>Neon · PostgreSQL</b><br/>anuncios · cargas · descargas<br/>respaldos · vistas")]
    OUT2 --> REG["Guarda registro de la ejecución<br/>ejecucion.json · resumen_ejecucion.txt · logs/"]
    REG --> FIN(["Cierra el navegador y termina<br/>sin dejar ventanas abiertas"])

    classDef p1 fill:#dbeafe,stroke:#1d4ed8,color:#0b1f4d
    classDef p2 fill:#fef3c7,stroke:#b45309,color:#3b2203
    classDef p3 fill:#dcfce7,stroke:#15803d,color:#0b2e17
    classDef io fill:#f3f4f6,stroke:#4b5563,color:#111827
    classDef fin fill:#ede9fe,stroke:#6d28d9,color:#2e1065
    classDef bd fill:#e0f2fe,stroke:#0369a1,color:#082f49
    class P1,O1 p1
    class P2,O2 p2
    class F1,F2,NAV,DL p3
    class IN,READ,OUT1,OUT2 io
    class START,RES,SHOW,REG,FIN fin
    class UPD,BAK,SQLITE,NEON,LOAD bd
    style S1 fill:#eff6ff,stroke:#1d4ed8
    style S2 fill:#fffbeb,stroke:#b45309
    style S3 fill:#f0fdf4,stroke:#15803d
