flowchart LR
    A["<b>Impresiones</b><br/>Valorización Local"] --> B["cpm = (valor ÷ Impresiones) × 1000<br/>Impresiones = 0 → vacío"]
    C["fecha_cast"] --> D["mes = yyyy-mm"]
    M["Marca"] --> G
    B --> G["Agrupar por<br/>(mes, marca)"]
    D --> G
    G --> S{"opción<br/>#45;#45;cpm-metodo"}
    S -->|"simple (default)"| PS["promedio de los cpm<br/>de las filas"]
    S -->|ponderado| PP["(Σ valor ÷ Σ impresiones) × 1000"]
    PS --> P["CPM promedio<br/>del mes y marca"]
    PP --> P
    P --> R["<b>cpm_delta</b> = promedio − cpm<br/>única columna nueva del paso 2"]
    B --> R
    P -.->|auditoría| AUD[/"resumen_cpm_mes_marca.csv"/]

    classDef p2 fill:#fef3c7,stroke:#b45309,color:#3b2203
    classDef io fill:#f3f4f6,stroke:#4b5563,color:#111827
    class R p2
    class AUD io
