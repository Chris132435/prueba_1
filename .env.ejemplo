# Copia este archivo como .env (en la carpeta del proyecto) y completa los valores.
# .env no se sube a git: ahí queda la contraseña de la base en la nube.

# Base SQLite local (para no escribir --db en cada comando)
ADMETRICKS_DB=C:\extraccion de datos\database\datos_prueba.db

# Conexión a Neon: consola de Neon → botón "Connect" → copia la cadena de conexión.
# Usa la conexión directa (sin "-pooler" en el host) para el respaldo.
NEON_DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-late-lab-b48wgsfv.REGION.aws.neon.tech/neondb?sslmode=require
